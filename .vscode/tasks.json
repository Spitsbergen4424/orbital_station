{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Собрать",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/EHsc",
                "/W4",
                "/utf-8",
                "/Zi",
                "/nologo",
                "/Fe${workspaceFolder}\\orbital_station.exe",
                "${workspaceFolder}\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
